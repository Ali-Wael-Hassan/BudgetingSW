<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="cardRoot"
            styleClass="goal-card"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.duck.GoalCardController">

    <VBox spacing="15.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <!-- Goal name row -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="goalNameLabel" styleClass="card-category" />
            <Region HBox.hgrow="ALWAYS" />
            <Region styleClass="icon-category-placeholder"
                    minWidth="24" minHeight="24"
                    maxWidth="24" maxHeight="24" />
        </HBox>

        <!-- Current / target amounts -->
        <HBox alignment="BASELINE_LEFT" spacing="5.0">
            <Label fx:id="currentLabel" styleClass="card-amount-spent" />
            <Label fx:id="targetLabel" styleClass="card-amount-limit" />
        </HBox>

        <!-- Progress section -->
        <VBox spacing="8.0">
            <HBox>
                <Label fx:id="progressLabel"  styleClass="card-text-small"   text="0%" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel"    styleClass="card-status-text"  text="On Track" />
            </HBox>
            <ProgressBar fx:id="progressBar"
                         progress="0.0"
                         maxWidth="Infinity"
                         styleClass="custom-progress-bar" />
        </VBox>

        <!-- Days to deadline -->
        <Label fx:id="daysLabel" styleClass="card-text-small" text="0 days remaining" />
    </VBox>

    <!-- Left border colour indicator (coloured by Controller based on status) -->
    <Region fx:id="statusBorder"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.topAnchor="0.0"
            styleClass="status-border"
            prefWidth="4.0" />
</AnchorPane>
