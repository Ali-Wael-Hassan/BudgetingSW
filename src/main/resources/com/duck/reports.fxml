<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.duck.ReportsController"
           styleClass="dashboard-root">
    <children>
        <HBox spacing="0" styleClass="dashboard-container">
            <children>
                <!-- Sidebar -->
                <VBox styleClass="sidebar" prefWidth="280">
                    <children>
                        <!-- Logo &amp; Profile Section -->
                        <VBox spacing="12" styleClass="sidebar-top">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <children>
                                        <StackPane fx:id="sidebarAvatarContainer" styleClass="user-avatar">
                                            <children>
                                                <Circle radius="24" fill="#1F2937" />
                                                <SVGPath styleClass="avatar-icon" content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="2">
                                            <children>
                                                <Label text="BudgetWise" styleClass="app-name" />
                                                <Label text="Financial Stewardship" styleClass="app-tagline" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Menu Items -->
                        <VBox spacing="0" styleClass="sidebar-menu" VBox.vgrow="ALWAYS">
                            <children>
                                <Button text="Dashboard"    styleClass="menu-button" onAction="#navigateToDashboard" />
                                <Button text="Transactions" styleClass="menu-button" onAction="#navigateToTransactions" />
                                <Button text="Budgets"      styleClass="menu-button" onAction="#navigateToBudgets" />
                                <Button text="Saving Goals" styleClass="menu-button" onAction="#navigateToGoals" />
                                <Button text="Reports"      styleClass="menu-button-active" />
                            </children>
                        </VBox>

                        <!-- Add Transaction Button -->
                        <VBox styleClass="sidebar-bottom">
                            <children>
                                <Button text="+ New Category"
                                        styleClass="add-transaction-btn"
                                        onAction="#handleAddCategory" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Main Content Area -->
                <VBox styleClass="main-content" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Top Header -->
                        <HBox styleClass="top-header" alignment="CENTER_LEFT">
                            <children>
                                <StackPane HBox.hgrow="ALWAYS" />

                                <!-- Header Icons -->
                                <HBox spacing="20" alignment="CENTER">
                                    <children>
                                        <Button text="Profile" styleClass="menu-button" onAction="#navigateToProfile" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Content Area -->
                        <ScrollPane styleClass="content-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="24" styleClass="content-area">
                                    <children>
                                        <!-- Page Header -->
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <VBox spacing="4">
                                                    <children>
                                                        <Label text="Financial Reports" styleClass="reports-title" />
                                                        <Label text="Comprehensive analysis of your fiscal activity." styleClass="reports-subtitle" />
                                                    </children>
                                                </VBox>
                                                <StackPane HBox.hgrow="ALWAYS" />
                                                <HBox spacing="12" alignment="CENTER">
                                                    <children>
                                                        <Button text="◀" onAction="#handlePrevMonth" styleClass="nav-btn" />
                                                        <Label fx:id="monthLabel" styleClass="month-label" />
                                                        <Button text="▶" onAction="#handleNextMonth" styleClass="nav-btn" />
                                                        <Button text="This Month" styleClass="date-filter-btn" onAction="#handleThisMonth" />
                                                        <Button text="Export"     styleClass="export-btn" onAction="#handleExport" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>

                                        <!-- Cards Grid -->
                                        <GridPane hgap="20" vgap="20">
                                            <children>

                                                <!-- CARD 1: Cash Flow (bar chart built by controller) -->
                                                <VBox styleClass="report-card"
                                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <children>
                                                        <Label text="Cash Flow" styleClass="card-title" />
                                                        <!-- bars injected here -->
                                                        <HBox fx:id="cashFlowChart"
                                                              spacing="16" alignment="BOTTOM_CENTER"
                                                              styleClass="bar-chart" />
                                                        <!-- Legend -->
                                                        <HBox spacing="20" alignment="CENTER" styleClass="chart-legend">
                                                            <children>
                                                                <HBox spacing="6" alignment="CENTER">
                                                                    <children>
                                                                        <StackPane styleClass="legend-dot-income" />
                                                                        <Label text="Income" styleClass="legend-label" />
                                                                    </children>
                                                                </HBox>
                                                                <HBox spacing="6" alignment="CENTER">
                                                                    <children>
                                                                        <StackPane styleClass="legend-dot-expense" />
                                                                        <Label text="Expense" styleClass="legend-label" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>

                                                <!-- CARD 2: Categories (donut legend built by controller) -->
                                                <VBox styleClass="report-card"
                                                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <children>
                                                        <Label text="Categories" styleClass="card-title" />
                                                        <StackPane fx:id="donutChart" styleClass="donut-container" prefHeight="160">
                                                            <children>
                                                                <Circle radius="60" styleClass="donut-chart" />
                                                                <VBox alignment="CENTER">
                                                                    <children>
                                                                        <Label fx:id="donutTotalLabel"  styleClass="donut-center-amount" />
                                                                        <Label                           text="Total Spent" styleClass="donut-center-label" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </StackPane>
                                                        <!-- legend rows injected here -->
                                                        <VBox fx:id="donutLegend" spacing="8" styleClass="donut-legend" />
                                                    </children>
                                                </VBox>

                                                <!-- CARD 3: Largest Expenses (list built by controller) -->
                                                <VBox styleClass="report-card"
                                                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT">
                                                            <children>
                                                                <Label text="Largest Expenses" styleClass="card-title" />
                                                                <StackPane HBox.hgrow="ALWAYS" />
                                                            </children>
                                                        </HBox>
                                                        <!-- expense rows injected here -->
                                                        <VBox fx:id="expenseList" spacing="12" styleClass="expense-list" />
                                                    </children>
                                                </VBox>

                                                <!-- CARD 4: Savings Goals (list built by controller) -->
                                                <VBox styleClass="report-card"
                                                      GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT">
                                                            <children>
                                                                <Label text="Savings Goals" styleClass="card-title" />
                                                                <StackPane HBox.hgrow="ALWAYS" />
                                                            </children>
                                                        </HBox>
                                                        <!-- goal rows injected here -->
                                                        <VBox fx:id="goalsList" spacing="16" styleClass="goals-list" />
                                                    </children>
                                                </VBox>

                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
