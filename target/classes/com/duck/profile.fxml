<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.duck.ProfileController"
           styleClass="dashboard-root">
    <children>
        <HBox spacing="0" styleClass="dashboard-container">
            <children>
                <!-- Sidebar -->
                <VBox styleClass="sidebar" prefWidth="280">
                    <children>
                        <!-- Logo and Profile Section -->
                        <VBox spacing="12" styleClass="sidebar-top">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <children>
                                        <StackPane fx:id="sidebarAvatarContainer" styleClass="user-avatar">
                                            <children>
                                                <Circle radius="24" fill="#1F2937" />
                                                <SVGPath styleClass="avatar-icon"
                                                         content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                            </children>
                                        </StackPane>
                                        <VBox spacing="2">
                                            <children>
                                                <Label text="BudgetWise"           styleClass="app-name" />
                                                <Label text="Financial Stewardship" styleClass="app-tagline" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Menu Items -->
                        <VBox spacing="0" styleClass="sidebar-menu" VBox.vgrow="ALWAYS">
                            <children>
                                <Button text="Dashboard"    styleClass="menu-button" onAction="#navigateToDashboard" />
                                <Button text="Transactions" styleClass="menu-button" onAction="#navigateToTransactions" />
                                <Button text="Budgets"      styleClass="menu-button" onAction="#navigateToBudgets" />
                                <Button text="Saving Goals" styleClass="menu-button" onAction="#navigateToGoals" />
                                <Button text="Reports"      styleClass="menu-button" onAction="#navigateToReports" />
                            </children>
                        </VBox>

                        <!-- Add Transaction Button -->
                        <VBox styleClass="sidebar-bottom">
                            <children>
                                <Button text="+ New Category"
                                        styleClass="add-transaction-btn"
                                        onAction="#handleAddCategory" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Main Content Area -->
                <VBox styleClass="main-content" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Top Header -->
                        <HBox styleClass="top-header" alignment="CENTER_LEFT">
                            <children>
                                <StackPane HBox.hgrow="ALWAYS" />

                                <!-- Header Icons -->
                                <HBox spacing="20" alignment="CENTER">
                                    <children>
                                        <Button text="Profile" styleClass="menu-button-active" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Content Area -->
                        <ScrollPane styleClass="content-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="32" styleClass="content-area">
                                    <children>
                                        <!-- Page Header -->
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <VBox spacing="4">
                                                    <children>
                                                        <Label text="Account Settings"                        styleClass="profile-title" />
                                                        <Label text="Manage your preferences and account details" styleClass="profile-subtitle" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Profile Card (dynamic: name + email from controller) -->
                                        <VBox styleClass="profile-card">
                                            <children>
                                                <HBox spacing="24" alignment="CENTER_LEFT">
                                                    <children>
                                                        <StackPane fx:id="profileAvatarContainer" styleClass="profile-avatar-large">
                                                            <children>
                                                                <Circle radius="50" fill="#1F2937" />
                                                                <SVGPath styleClass="profile-avatar-icon"
                                                                         content="M12 12c2.21 0 4-1.79 4-5s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                                            </children>
                                                        </StackPane>
                                                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label fx:id="profileNameLabel"  text="" styleClass="profile-name" />
                                                                <Label fx:id="profileEmailLabel" text="" styleClass="profile-email" />
                                                            </children>
                                                        </VBox>
                                                        <Button text="Edit Profile"
                                                                styleClass="edit-profile-btn"
                                                                onAction="#handleEditProfile" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Settings Grid -->
                                        <GridPane hgap="24" vgap="24">
                                            <children>

                                                <!-- CARD 1: Appearance -->
                                                <VBox styleClass="settings-card"
                                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                                            <children>
                                                                <StackPane styleClass="settings-icon">
                                                                    <children>
                                                                        <Circle radius="20" fill="#1F2937" />
                                                                        <SVGPath styleClass="settings-icon-svg"
                                                                                 content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
                                                                    </children>
                                                                </StackPane>
                                                                <Label text="Appearance" styleClass="settings-card-title" />
                                                            </children>
                                                        </HBox>
                                                        <Label text="Choose your preferred theme" styleClass="settings-card-desc" />
                                                        <VBox spacing="12" styleClass="theme-options">
                                                            <children>
                                                                <!-- FIX: theme toggle buttons built by controller via fx:id -->
                                                                <HBox fx:id="themeToggleBox" spacing="12" alignment="CENTER_LEFT" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>

                                                <!-- CARD 2: Currency -->
                                                <VBox styleClass="settings-card"
                                                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                                            <children>
                                                                <StackPane styleClass="settings-icon">
                                                                    <children>
                                                                        <Circle radius="20" fill="#1F2937" />
                                                                        <SVGPath styleClass="settings-icon-svg"
                                                                                 content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.35 3.68 3.74V19h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" />
                                                                    </children>
                                                                </StackPane>
                                                                <Label text="Currency" styleClass="settings-card-title" />
                                                            </children>
                                                        </HBox>
                                                        <Label text="Select your preferred currency" styleClass="settings-card-desc" />
                                                        <VBox spacing="12" styleClass="currency-options">
                                                            <children>
                                                                <!--
                                                                    FIX: currency symbols like € £ ¥ ر.س ج.م are non-ASCII.
                                                                    Safe options:
                                                                      Euro sign     : &#x20AC;  (€)
                                                                      Pound sign    : &#xA3;    (£)
                                                                      Yen sign      : &#xA5;    (¥)
                                                                    Arabic strings are valid UTF-8 but safest to keep them
                                                                    in the Controller as Java string literals, not in FXML.
                                                                    All currency toggles are therefore built programmatically.
                                                                -->
                                                                <HBox fx:id="currencyRow1" spacing="8" alignment="CENTER_LEFT" />
                                                                <HBox fx:id="currencyRow2" spacing="8" alignment="CENTER_LEFT" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>

                                                <!-- CARD 3: Security -->
                                                <VBox styleClass="settings-card"
                                                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                                            <children>
                                                                <StackPane styleClass="settings-icon">
                                                                    <children>
                                                                        <Circle radius="20" fill="#1F2937" />
                                                                        <SVGPath styleClass="settings-icon-svg"
                                                                                 content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                                                                    </children>
                                                                </StackPane>
                                                                <Label text="Security" styleClass="settings-card-title" />
                                                            </children>
                                                        </HBox>
                                                        <Label text="Protect your account" styleClass="settings-card-desc" />
                                                        <!-- security action rows built by controller -->
                                                        <VBox fx:id="securityOptions" spacing="16" styleClass="security-options" />
                                                    </children>
                                                </VBox>

                                            </children>
                                        </GridPane>

                                        <!-- Danger Zone -->
                                        <VBox styleClass="danger-zone">
                                            <children>
                                                <Label text="Danger Zone" styleClass="danger-title" />
                                                <HBox alignment="CENTER_LEFT" styleClass="danger-item">
                                                    <children>
                                                        <VBox HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="Delete Account"                                  styleClass="danger-label" />
                                                                <Label text="Permanently delete your account and all data"    styleClass="danger-desc" />
                                                            </children>
                                                        </VBox>
                                                        <Button text="Delete Account"
                                                                styleClass="delete-btn"
                                                                onAction="#handleDeleteAccount" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
